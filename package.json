{
  "name": "aaa-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AAA Insights — customer, competitive & relationship insight. Phase 4 (IMPLEMENT), built to Requirements v7.1.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && cp src/persistence/schema.sql dist/persistence/schema.sql",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.5",
    "pg": "^8.23.0"
  }
}
