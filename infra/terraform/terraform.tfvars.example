# Copy to terraform.tfvars and adjust if needed. The defaults already target the
# aaa-insights project in us-central1, so for the standard setup you can skip this file.

# project_id = "aaa-insights"
# region     = "us-central1"
# db_tier    = "db-f1-micro"

# --- Claude via Vertex (turn on the real AI answerer) ---
# Copy these into terraform.tfvars to make `terraform apply` deploy Claude with no -var flags.
# NOTE: vertex_region is deliberately NOT us-central1 — us-central1 serves no Claude Sonnet.
# api_image     = "us-central1-docker.pkg.dev/aaa-insights/aaa-insights/api:v2"
# llm_provider  = "vertex"
# vertex_region = "us-east5"                    # Sonnet served here (US soil, DPS-9 holds)
# vertex_model  = "claude-sonnet-4-5@20250929"  # Claude Sonnet 4.5 (GA). NOTE: Sonnet 4 (…-4@20250514) is
#                                               # RETIRED in us-east5 (404). 4.5 must be enabled in Model
#                                               # Garden + hold token quota for base_model
#                                               # anthropic-claude-sonnet-4-5 in us-east5.
